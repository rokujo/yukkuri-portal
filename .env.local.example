# =====================================================================
# 上松ゆっくり塾 窓口サイト - 環境変数サンプル
#
# このファイルをコピーして .env.local を作成し、実際の値を入れてください。
#   cp .env.local.example .env.local
#
# 本番では Vercel の Environment Variables 画面で同じキーを設定します。
# .env.local は .gitignore 対象なのでリポジトリには含まれません。
# =====================================================================

# 塾生エリア (/students/) のBasic認証パスワード
# ユーザー名は "student" で固定（middleware.ts 参照）
STUDENT_PASSWORD=change-me

# パスワードの有効期限表示（自由形式の文字列）
# 例: "2026年9月末まで" / "2026/10/31 まで"
PASSWORD_EXPIRES_AT=2026年9月末まで

# 各アプリ（access: kampa）のカンパ用パスワード
# 命名規則: KAMPA_PW_<APP_ID> （IDのハイフンはアンダースコアに、すべて大文字）
#   english-writing  -> KAMPA_PW_ENGLISH_WRITING
#   english-speaking -> KAMPA_PW_ENGLISH_SPEAKING
#   ...
# 未設定のアプリは塾生ページで「未設定」と表示されます。
KAMPA_PW_ENGLISH_WRITING=
KAMPA_PW_ENGLISH_SPEAKING=
KAMPA_PW_ENGLISH_LISTENING=
KAMPA_PW_ENGLISH_READING=
KAMPA_PW_ENGLISH_VOCABULARY=
KAMPA_PW_MATH_FORMULA_DRILL=
KAMPA_PW_CHEMISTRY_MEMORIZE=
